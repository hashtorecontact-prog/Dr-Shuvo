# Public website URL used for canonical metadata (update to your live domain)
VITE_SITE_URL="https://drashikortho.com"

# Base path for deployment ("/" for domain root, or "/clinic/" for subdirectory deployment)
VITE_BASE_PATH="/"

# Optional: Override verified doctor portrait URL if replacing the bundled portrait
VITE_DOCTOR_PORTRAIT_URL=""

# Optional: Contact form submission endpoint (e.g., "./contact.php" on cPanel or Formspree URL)
VITE_CONTACT_ENDPOINT=""
